# Copy to .env.local and adjust if your backends run on different ports.
# .env.local is gitignored - Vite loads it automatically (`npm run dev`).

# authService — register/login/me. Same service the user dashboard talks to; the only
# difference is which role the person logging in holds.
VITE_AUTH_API_URL=http://localhost:8080

# petManagementService (Core) — centers, members, and (later) intake/adoption/boarding
VITE_CORE_API_URL=http://localhost:8081
